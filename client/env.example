# Pipecat Cloud agent (must match agent_name in ../server/pcc-deploy.toml)
PCC_AGENT_NAME=pipecat-moq-example

# Pipecat Cloud *public* API key (Dashboard -> Settings -> Public API keys).
# Only ever used server-side by this proxy; never shipped to the browser.
PCC_PUBLIC_API_KEY=

# MoQ relay the browser and the bot both dial. Must match MOQ_RELAY_URL in the
# bot's secret set so both sides rendezvous on the same relay.
MOQ_RELAY_URL=https://cdn.moq.dev/anon

# Optional: shared passcode for a public demo deployment. When set, open the UI
# as https://<host>/client/?key=<ACCESS_KEY> once; unset = open access.
# ACCESS_KEY=

# Optional overrides
# PCC_START_URL=https://api.pipecat.daily.co/v1/public/pipecat-moq-example/start
# PORT=7861
