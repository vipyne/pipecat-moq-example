# Deepgram (STT)
DEEPGRAM_API_KEY=

# Cartesia (TTS)
CARTESIA_API_KEY=

# LLM — choose one:
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

MOQ_RELAY_URL=https://cdn.moq.dev/anon
# Optional: seconds to wait for the browser's broadcast at the relay (default 60)
MOQ_CONNECTION_TIMEOUT=60
# Optional: seconds to wait for a subscriber on the bot's audio track before it
# starts talking (default 15)
MOQ_SUBSCRIBER_TIMEOUT=15

# Pipecat Cloud log level (the transport's connect/publish lines are DEBUG)
PIPECAT_LOG_LEVEL=DEBUG
